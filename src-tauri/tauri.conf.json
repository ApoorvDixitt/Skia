{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skia",
  "version": "../package.json",
  "identifier": "com.apoorvdixitt.skia",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Skia",
        "width": 680,
        "height": 58,
        "minWidth": 480,
        "minHeight": 64,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "x": 380,
        "y": 96
      },
      {
        "label": "dashboard",
        "title": "Skia",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "focus": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Apoorv Dixit",
    "shortDescription": "A local-first meeting copilot.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
